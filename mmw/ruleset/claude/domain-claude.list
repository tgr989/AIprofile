browser-intake-us5-datadoghq.com
cdn.growthbook.io
cdn.usefathom.com

# 风控服务。
+.siftscience.com

# Stripe.js 遥测与 Firebase 推送注册的共用端点，按需启用。
# r.stripe.com
# fcmtoken.googleapis.com

# hCaptcha 由云服务分组的 hcaptcha.mrs 覆盖。
# X 分流清单列出的共用 Cloudflare 人机验证域名，按需启用。
# challenges.cloudflare.com

# 共用认证域名按需启用。Google 登录及 OAuth / OpenID Connect。
# accounts.google.com
# oauth2.googleapis.com
# openidconnect.googleapis.com

# Apple 授权及账户认证。
# appleid.apple.com
# idmsa.apple.com

# Google 地图 API 用于身份核验相关请求。
# maps.googleapis.com

# NodeSeek 列出的页面静态资源和 Claude Code 下载域名。
# t0.gstatic.com
# t1.gstatic.com
# t2.gstatic.com
# t3.gstatic.com
# storage.googleapis.com
